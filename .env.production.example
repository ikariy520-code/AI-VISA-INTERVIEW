# ========================================
# AI Visa Interview — Production Environment
# Copy this to .env.production and fill in real keys.
# ========================================

# === Commercial order gate ===
# Unlimited administrator order identities. Never publish these as customer orders.
ADMIN_ORDER_NUMBERS=your-first-admin-number,your-second-admin-number
ORDER_SESSION_SECRET=generate-a-random-secret-of-at-least-32-characters
ORDER_NUMBERS_FILE=data/orders.json
ORDER_USAGE_FILE=data/order-usage.json

# === Real-time Voice (WebSocket proxy to Doubao) ===
DOUBAO_APP_ID=your-doubao-app-id
DOUBAO_ACCESS_KEY=your-doubao-access-token
DOUBAO_REALTIME_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue

# === Final report model (server-side; OpenAI-compatible protocol) ===
REPORT_PROVIDER=deepseek
REPORT_API_KEY=your-report-model-api-key
REPORT_MODEL=deepseek-v4-pro
REPORT_BASE_URL=https://api.deepseek.com
REPORT_SUPPORTS_JSON_MODE=true
REPORT_SUPPORTS_REASONING_OPTIONS=true

# Backward-compatible DeepSeek names; omit these when REPORT_* is set.
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# === Server ===
PORT=3000
HOST=127.0.0.1
WS_MAX_CONNECTIONS=30
