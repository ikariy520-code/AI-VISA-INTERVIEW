# ========================================
# AI Visa Interview — Production Environment
# Copy this to .env.production and fill in real keys.
# ========================================

# === Real-time Voice (WebSocket proxy to Doubao) ===
DOUBAO_SPEECH_API_KEY=your-doubao-speech-api-key
DOUBAO_REALTIME_URL=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue

# === AI Interview Report (Doubao Ark text API) ===
ARK_API_KEY=your-ark-api-key
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3/chat/completions
ARK_TEXT_MODEL=ep-your-doubao-text-endpoint-id

# === Server ===
PORT=3000
WS_MAX_CONNECTIONS=30
