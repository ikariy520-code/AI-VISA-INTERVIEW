{
  "name": "ai-visa-interview",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "npm run test:invite && npm run test:officers && npm run test:f1-controller && npm run test:realtime-turn && npm run test:report-depth && npm run test:f1-report && npm run test:architecture",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "deploy": "bash scripts/deploy.sh",
    "smoke:realtime": "node scripts/realtimeVoiceSmoke.mjs",
    "smoke:deepseek": "node scripts/deepseekConnectivitySmoke.mjs",
    "smoke:report": "node scripts/finalReportSmoke.mjs",
    "invite:generate": "node scripts/inviteAdmin.mjs generate",
    "invite:status": "node scripts/inviteAdmin.mjs status",
    "invite:reset": "node scripts/inviteAdmin.mjs reset",
    "test:invite": "node scripts/inviteAuth.test.mjs",
    "test:officers": "node --experimental-strip-types scripts/officerTypes.test.ts",
    "test:f1-controller": "node --experimental-strip-types scripts/f1InterviewController.test.ts",
    "test:realtime-turn": "node --experimental-strip-types scripts/realtimeTurnGuard.test.ts",
    "test:report-depth": "node --experimental-strip-types scripts/reportDepth.test.ts",
    "test:f1-report": "node --experimental-strip-types scripts/f1ReportContract.test.ts",
    "test:architecture": "node scripts/singleExternalAiAudit.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "framer-motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0",
    "react-router-dom": "^6.28.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
