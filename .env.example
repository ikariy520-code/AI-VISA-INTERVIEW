# ========================================
# 环境变量 — AI Visa Interview
#
# 复制此文件为 .env.local（本地开发用）
# 部署到 Netlify 时在 Dashboard → Site Settings → Environment Variables 中设置
# ========================================

# DeepSeek API Key（必填）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# DeepSeek 模型名称（可选，默认 deepseek-chat）
DEEPSEEK_MODEL=deepseek-chat

# Vite 开发服务器端口（可选，默认 5173）
VITE_DEV_PORT=5173
