# ========================================
# 环境变量 — AI Visa Interview
#
# 复制此文件为 .env.local（本地开发用）
# ========================================

# 内部测试邀请码（逗号分隔）与登录凭证签名密钥
# 仅放在服务端环境变量中，不要添加 VITE_ 前缀。
INVITE_CODES=your-first-code,your-second-code
INVITE_SESSION_SECRET=generate-a-random-secret-of-at-least-32-characters

# 豆包全双工实时语音（本地面签必需）
# 密钥只能放在本地服务端变量中，绝对不要添加 VITE_ 前缀。
DOUBAO_APP_ID=
DOUBAO_ACCESS_KEY=
DOUBAO_REALTIME_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue

# 面试结束后整场只调用一次，用于生成结构化反馈报告
ARK_API_KEY=
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3/chat/completions
ARK_TEXT_MODEL=ep-your-doubao-text-endpoint-id

# Vite 开发服务器端口（可选，默认 5173）
VITE_DEV_PORT=5173
