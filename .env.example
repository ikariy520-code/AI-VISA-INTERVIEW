# ========================================
# 环境变量 — AI Visa Interview
#
# 复制此文件为 .env.local（本地开发用）
# ========================================

# 豆包全双工实时语音（本地面签必需）
# 密钥只能放在本地服务端变量中，绝对不要添加 VITE_ 前缀。
DOUBAO_SPEECH_API_KEY=
# Legacy aliases (optional):
DOUBAO_API_KEY=
# 也可使用同义变量名 SPEECH_API_KEY。火山方舟的 ark- Key 不适用于此接口。
SPEECH_API_KEY=
DOUBAO_ASR_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
DOUBAO_ASR_RESOURCE_ID=volc.bigasr.sauc.duration
DOUBAO_TTS_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
# Temporary bilingual preset. Replace with an authorized cloned speaker ID later.
DOUBAO_TTS_SPEAKER=zh_female_vv_uranus_bigtts
DOUBAO_REALTIME_URL=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue

# 原有文本练习/评分流程（可选，与实时语音相互独立）
TEXT_AI_API_KEY=
AI_API_KEY=
AI_API_BASE=https://api.deepseek.com/v1/chat/completions
AI_MODEL=deepseek-chat

# 邀请码管理员配置（当前本地实时面签不会使用）
ADMIN_API_TOKEN=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
RATE_LIMIT_SALT=replace-with-another-random-secret

# Vite 开发服务器端口（可选，默认 5173）
VITE_DEV_PORT=5173
