# AI Visa Interview - local development
# Copy this file to .env.local. Never commit real credentials.

# Unlimited VIP codes. Existing deployments can keep their current two values.
INVITE_CODES=your-first-code,your-second-code
INVITE_SESSION_SECRET=generate-a-random-secret-of-at-least-32-characters
INVITE_CODES_FILE=server/inviteCodes.json
INVITE_USAGE_FILE=data/invite-usage.json

# Real-time interview voice (server-side credentials only).
DOUBAO_APP_ID=
DOUBAO_ACCESS_KEY=
DOUBAO_REALTIME_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue

# One evidence-bound final report request after the interview (server-side only).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

VITE_DEV_PORT=5173
