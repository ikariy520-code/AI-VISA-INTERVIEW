# ========================================
# 环境变量 — AI Visa Interview
#
# 复制此文件为 .env.local（本地开发用）
# 部署到 Cloudflare 时在 Workers → Settings → Variables and Secrets 中设置
# ========================================

# Supabase 浏览器端配置（Supabase 项目设置 → API）
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Cloudflare Worker 运行时配置
# Publishable Key 可以公开，但访问安全仍依赖数据库 RLS。
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# DeepSeek API Key（仅服务端，绝不能添加 VITE_ 前缀）
DEEPSEEK_API_KEY=sk-your-key-here

# DeepSeek 模型名称（可选，默认 deepseek-chat）
DEEPSEEK_MODEL=deepseek-chat

# Vite 开发服务器端口（可选，默认 5173）
VITE_DEV_PORT=5173
