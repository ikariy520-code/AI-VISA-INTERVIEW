# ========================================
# 环境变量 — AI Visa Interview
#
# 复制此文件为 .env.local（本地开发用）
# ========================================

# 豆包全双工实时语音（本地面签必需）
# 密钥只能放在本地服务端变量中，绝对不要添加 VITE_ 前缀。
DOUBAO_SPEECH_API_KEY=
DOUBAO_REALTIME_URL=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue

# 面试结束后整场只调用一次，用于生成结构化反馈报告
ARK_API_KEY=
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3/chat/completions
ARK_TEXT_MODEL=ep-your-doubao-text-endpoint-id

# 邀请码管理员配置（当前本地实时面签不会使用）
ADMIN_API_TOKEN=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
RATE_LIMIT_SALT=replace-with-another-random-secret

# Vite 开发服务器端口（可选，默认 5173）
VITE_DEV_PORT=5173
