# AI Visa Interview - local development
# Copy this file to .env.local. Never commit real credentials.

# Unlimited administrator order identities.
ADMIN_ORDER_NUMBERS=your-first-admin-number,your-second-admin-number
ORDER_SESSION_SECRET=generate-a-random-secret-of-at-least-32-characters
ORDER_NUMBERS_FILE=data/orders.json
ORDER_USAGE_FILE=data/order-usage.json

# Real-time interview voice (server-side credentials only).
DOUBAO_APP_ID=
DOUBAO_ACCESS_KEY=
DOUBAO_REALTIME_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue

# One evidence-bound final report request after the interview (server-side only).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

VITE_DEV_PORT=5173
