# ========================================
# 环境变量 — AI Visa Interview
#
# 复制此文件为 .env.local（本地开发用）
# 部署到 Cloudflare 时在 Workers → Settings → Variables and Secrets 中设置
# ========================================

# AI 服务端配置（当前先留空；任何密钥都不能添加 VITE_ 前缀）
AI_API_KEY=
AI_API_BASE=https://api.deepseek.com/v1/chat/completions
AI_MODEL=deepseek-chat

# 邀请码管理员配置（仅 Cloudflare Worker 运行时）
ADMIN_API_TOKEN=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
RATE_LIMIT_SALT=replace-with-another-random-secret

# Vite 开发服务器端口（可选，默认 5173）
VITE_DEV_PORT=5173
